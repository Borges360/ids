{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/terminal/1.0.0/capabilities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interactive",
    "columns",
    "rows",
    "color",
    "unicode",
    "advancedKeyboard",
    "mouse",
    "screen",
    "mode",
    "reducedMotion"
  ],
  "properties": {
    "interactive": {
      "type": "boolean"
    },
    "columns": {
      "type": "integer",
      "minimum": 1
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "color": {
      "type": "boolean"
    },
    "unicode": {
      "type": "boolean"
    },
    "advancedKeyboard": {
      "type": "boolean"
    },
    "mouse": {
      "type": "boolean"
    },
    "screen": {
      "type": "boolean"
    },
    "mode": {
      "enum": [
        "linear",
        "prompts",
        "panel",
        "workspace",
        "host",
        "json"
      ]
    },
    "reducedMotion": {
      "type": "boolean"
    }
  }
}
