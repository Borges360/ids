{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/experiment-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "idsCommit",
    "datasetHash",
    "configHash",
    "environmentHash",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "idsCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "datasetHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environmentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "model",
          "ablation",
          "seed",
          "accepted",
          "initialAccepted",
          "attempts",
          "durationMs",
          "cost",
          "tokensIn",
          "tokensOut",
          "humanMinutes"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "\\S"
          },
          "model": {
            "type": "string",
            "pattern": "\\S"
          },
          "ablation": {
            "enum": [
              "unassisted",
              "context",
              "composition-lint",
              "visual-repair"
            ]
          },
          "seed": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "accepted": {
            "type": "boolean"
          },
          "initialAccepted": {
            "type": "boolean"
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "cost": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "costBreakdown": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "currency",
              "modelTokens",
              "tools",
              "humanReview",
              "infrastructure"
            ],
            "properties": {
              "schemaVersion": {
                "const": "1.0"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "modelTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "tools": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "humanReview": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "infrastructure": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "tokensIn": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tokensOut": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "humanMinutes": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "evidencePath": {
            "type": "string",
            "pattern": "\\S"
          },
          "evidenceHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "gradingPath": {
            "type": "string",
            "pattern": "\\S"
          },
          "gradingHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "workerId": {
            "type": "string",
            "pattern": "^worker-[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
          },
          "outcome": {
            "enum": [
              "accepted",
              "model_failure",
              "environment_error",
              "incomplete"
            ]
          }
        },
        "dependencies": {
          "evidencePath": [
            "evidenceHash"
          ],
          "evidenceHash": [
            "evidencePath"
          ],
          "gradingPath": [
            "gradingHash"
          ],
          "gradingHash": [
            "gradingPath"
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "initialAccepted": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "accepted": {
                  "const": true
                },
                "attempts": {
                  "const": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "accepted": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "evidencePath",
                "evidenceHash",
                "gradingPath",
                "gradingHash"
              ]
            }
          },
          {
            "if": {
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "const": "accepted"
                }
              }
            },
            "then": {
              "properties": {
                "accepted": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "outcome"
              ],
              "properties": {
                "outcome": {
                  "enum": [
                    "model_failure",
                    "environment_error",
                    "incomplete"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "accepted": {
                  "const": false
                },
                "initialAccepted": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    }
  }
}
