{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/technical-authority-policy.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "authorities"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "authorities": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9._-]+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^-----BEGIN PUBLIC KEY-----"
      }
    }
  }
}
