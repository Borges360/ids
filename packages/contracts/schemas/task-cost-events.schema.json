{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/task-cost-events.schema.json",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "category",
      "currency",
      "cost"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "\\S"
      },
      "category": {
        "enum": [
          "modelTokens",
          "tools",
          "humanReview",
          "infrastructure"
        ]
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "cost": {
        "type": [
          "number",
          "null"
        ],
        "minimum": 0
      }
    }
  }
}
