{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/pattern.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "kind",
    "description",
    "slots",
    "variants",
    "states",
    "requiredTokens",
    "allowedDependencies",
    "accessibility",
    "responsive",
    "examples",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string"
    },
    "kind": {
      "const": "pattern"
    },
    "description": {
      "type": "string"
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "requiredTokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedDependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accessibility": {
      "type": "object"
    },
    "responsive": {
      "type": "object"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
