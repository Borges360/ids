{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/review-calibration-reviewers.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "reviewers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "publicKey"
        ],
        "properties": {
          "kind": {
            "enum": [
              "human",
              "synthetic"
            ]
          },
          "publicKey": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  }
}
