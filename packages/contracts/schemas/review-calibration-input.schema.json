{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/review-calibration-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "reference",
    "configHash",
    "currency",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "recorded-review-calibration"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "reviewer",
          "version",
          "promptHash",
          "artifactHashes",
          "axes",
          "verdict",
          "rank",
          "cost",
          "durationMs",
          "tokensIn",
          "tokensOut"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "\\S"
          },
          "reviewer": {
            "type": "string",
            "pattern": "\\S"
          },
          "version": {
            "type": "string",
            "pattern": "\\S"
          },
          "promptHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "artifactHashes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "axes": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 7,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "axis",
                    "score",
                    "evidenceId",
                    "element",
                    "reason",
                    "action"
                  ],
                  "properties": {
                    "axis": {
                      "enum": [
                        "hierarchy",
                        "composition",
                        "density",
                        "identity",
                        "content",
                        "responsiveness",
                        "robustness"
                      ]
                    },
                    "score": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4
                    },
                    "evidenceId": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "element": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "reason": {
                      "type": "string",
                      "pattern": "\\S"
                    },
                    "action": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                },
                "maxItems": 7
              },
              {
                "type": "null"
              }
            ]
          },
          "verdict": {
            "enum": [
              "accept",
              "block",
              "insufficient"
            ]
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "cost": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          },
          "tokensIn": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "tokensOut": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": [
                    "accept",
                    "block"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "axes": {
                  "type": "array",
                  "minItems": 7,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "axis",
                      "score",
                      "evidenceId",
                      "element",
                      "reason",
                      "action"
                    ],
                    "properties": {
                      "axis": {
                        "enum": [
                          "hierarchy",
                          "composition",
                          "density",
                          "identity",
                          "content",
                          "responsiveness",
                          "robustness"
                        ]
                      },
                      "score": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4
                      },
                      "evidenceId": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "element": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "reason": {
                        "type": "string",
                        "pattern": "\\S"
                      },
                      "action": {
                        "type": "string",
                        "pattern": "\\S"
                      }
                    }
                  },
                  "maxItems": 7
                }
              }
            }
          }
        ]
      }
    }
  }
}
