{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/task-grading-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "runId",
    "caseId",
    "sourceHash",
    "gitSha",
    "configHash",
    "grading",
    "fixture",
    "plannedScenarios",
    "assertionTimeoutMs",
    "status",
    "executed",
    "results",
    "agentExecution"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "independent-task-grading"
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[a-f0-9-]{36}$"
    },
    "caseId": {
      "type": "string",
      "pattern": "\\S"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "plannedScenarios": {
      "type": "integer",
      "minimum": 1
    },
    "assertionTimeoutMs": {
      "type": "integer",
      "minimum": 500,
      "maximum": 30000
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "error",
        "not_run"
      ]
    },
    "executed": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "completedSteps",
          "plannedSteps"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "completedSteps": {
            "type": "integer",
            "minimum": 0
          },
          "plannedSteps": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "pattern": "\\S"
          },
          "zoom": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "factor",
              "before",
              "after"
            ],
            "properties": {
              "method": {
                "const": "native-browser-tab-zoom"
              },
              "factor": {
                "enum": [
                  1,
                  2
                ]
              },
              "before": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cssWidth",
                  "dpr"
                ],
                "properties": {
                  "cssWidth": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "dpr": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "after": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cssWidth",
                  "dpr"
                ],
                "properties": {
                  "cssWidth": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "dpr": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        }
      }
    },
    "browserVersion": {
      "type": "string",
      "pattern": "\\S"
    },
    "message": {
      "type": "string",
      "pattern": "\\S"
    },
    "agentExecution": {
      "const": "not_run"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "required": [
          "browserVersion",
          "hash"
        ],
        "properties": {
          "executed": {
            "minimum": 1
          },
          "results": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_run"
          }
        }
      },
      "then": {
        "properties": {
          "executed": {
            "const": 0
          },
          "results": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "passed",
              "failed",
              "error"
            ]
          }
        }
      },
      "then": {
        "required": [
          "hash"
        ]
      }
    }
  ]
}
