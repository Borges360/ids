{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/evidence-bundle.schema.json",
  "type": "object",
  "allOf": [
    {
      "if": {
        "required": [
          "evidenceFormat"
        ]
      },
      "then": {
        "required": [
          "projectId",
          "gitSha",
          "sourceHash",
          "contractHash",
          "startedAt",
          "finishedAt",
          "exitCode"
        ],
        "properties": {
          "evidenceFormat": {
            "const": "inteiro-evidence/v1.1"
          },
          "projectId": {
            "type": "string"
          },
          "gitSha": {
            "type": "string"
          },
          "sourceHash": {
            "type": "string"
          },
          "contractHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "exitCode": {
            "type": "integer"
          },
          "artifacts": {
            "items": {
              "type": "object",
              "required": [
                "path",
                "relativePath",
                "sha256",
                "mediaType",
                "privacyClass"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "relativePath": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "mediaType": {
                  "type": "string"
                },
                "privacyClass": {
                  "enum": [
                    "public",
                    "internal",
                    "restricted"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "inteiroVersion": {
      "type": "string"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string"
    },
    "configId": {
      "type": "string"
    },
    "governanceContractHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "enum": [
        "dev",
        "pr",
        "ci",
        "main",
        "nightly",
        "release"
      ]
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "status": {
      "enum": [
        "not_run",
        "running",
        "passed",
        "failed",
        "blocked",
        "needs_review",
        "waived",
        "error"
      ]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "findings",
          "durationMs"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "not_run",
              "running",
              "passed",
              "failed",
              "blocked",
              "needs_review",
              "waived",
              "error"
            ]
          },
          "findings": {
            "type": "array"
          },
          "durationMs": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "findings": {
      "type": "array"
    },
    "artifacts": {
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "inteiroVersion",
    "hash",
    "createdAt",
    "configId",
    "configHash",
    "runId",
    "status",
    "gates",
    "findings",
    "artifacts"
  ]
}
