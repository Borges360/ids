{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/implementation-contract.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "inteiroVersion": {
      "type": "string"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string"
    },
    "configId": {
      "type": "string"
    },
    "framework": {
      "type": "string"
    },
    "allowedImports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "restrictions": {
      "type": "object"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "inteiroVersion",
    "hash",
    "createdAt",
    "configId",
    "framework",
    "restrictions",
    "checks"
  ]
}
