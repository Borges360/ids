{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/task-manifest.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "type",
    "description",
    "patternIds",
    "scope",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,159}$"
    },
    "type": {
      "enum": [
        "new-page",
        "change-page",
        "component",
        "fix",
        "refactor",
        "new-pattern",
        "significant-layout-change",
        "identity-change"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "patternIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedFiles"
      ],
      "properties": {
        "allowedFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contextBundleId": {
      "type": "string",
      "pattern": "^context:[a-f0-9]{64}$"
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewRequired": {
      "type": "boolean"
    },
    "excludedByRequester": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contractRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
