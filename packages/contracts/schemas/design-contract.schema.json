{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/design-contract.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "inteiroVersion": {
      "type": "string"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string"
    },
    "configId": {
      "type": "string"
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "densities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "inteiroVersion",
    "hash",
    "createdAt",
    "configId",
    "tokens",
    "patterns",
    "themes",
    "densities"
  ]
}
