{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://inteiro.dev/schemas/1.0/visual-acceptance-contract.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "inteiroVersion": {
      "type": "string"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string"
    },
    "configId": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "viewports": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policy": {
      "type": "object"
    },
    "environment": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "inteiroVersion",
    "hash",
    "createdAt",
    "configId",
    "routes",
    "viewports",
    "policy",
    "environment"
  ]
}
