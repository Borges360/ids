{
  "name": "@inteiro/tokens",
  "version": "1.1.1",
  "description": "INTEIRO Identity Design System — catálogo DTCG 2025.10, temas e exportações",
  "type": "module",
  "sideEffects": [
    "./dist/css/*.css"
  ],
  "files": [
    "dist",
    "source",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "import": "./dist/js/index.js"
    },
    "./css": "./dist/css/inteiro.css",
    "./css/dark": "./dist/css/dark.css",
    "./css/light": "./dist/css/light.css",
    "./css/contrast": "./dist/css/contrast.css",
    "./scss": "./dist/scss/_inteiro.scss",
    "./json": "./dist/json/tokens.json",
    "./catalog": "./dist/json/catalog.json",
    "./source/*": "./source/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "validate": "node --experimental-strip-types src/cli-validate.ts",
    "build": "node --experimental-strip-types src/build.ts",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "engines": {
    "node": ">=22.14"
  },
  "license": "MIT"
}
