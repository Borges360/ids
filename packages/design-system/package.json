{
  "name": "@inteiro/design-system",
  "version": "1.1.1",
  "description": "INTEIRO Design System SDK — tokens, CSS, recipes e CLI",
  "type": "module",
  "bin": {
    "inteiro": "../cli/src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./css": "./src/inteiro.css",
    "./css/components": "./src/components.css",
