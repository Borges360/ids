  },
  "dependencies": {
    "@inteiro/tokens": "1.1.1",
    "@inteiro/cli": "1.1.1",
    "@inteiro/agent-core": "1.1.1"
  },
  "engines": {
    "node": ">=22.14"
  },
  "license": "MIT"
}
