{
  "schemaVersion": "1.0",
  "id": "tooltip",
  "version": "1.0.0",
  "kind": "pattern",
  "description": "Dica ajuda acessível",
  "slots": [
    "content"
  ],
  "variants": [
    "default"
  ],
  "states": [
    "default"
  ],
  "requiredTokens": [
    "color.background.canvas",
    "color.text.primary"
  ],
  "allowedDependencies": [
    "@inteiro/tokens",
    "@inteiro/design-system"
  ],
  "accessibility": {
    "semantics": [
      "span",
      "button"
    ],
    "keyboardSpec": "docs/P0_PATTERNS.md"
  },
  "responsive": {
    "mobileStrategy": "reflow"
  },
  "examples": [
    "examples/tooltip.html",
    "examples/tooltip-default.html"
  ],
  "tests": [
    "tests/browser/composition.spec.ts"
  ],
  "aliases": [
    "dica",
    "ajuda",
    "acessível"
  ],
  "markup": "<span class=\"in-tooltip\" data-in-tooltip><button aria-describedby=\"tip\">Ajuda</button><span role=\"tooltip\" id=\"tip\">Informações sobre esta ação.</span></span>"
}
