{
  "schemaVersion": "1.0",
  "id": "topbar",
  "version": "1.0.0",
  "kind": "pattern",
  "description": "Barra superior",
  "slots": [
    "content"
  ],
  "variants": [
    "default"
  ],
  "states": [
    "default"
  ],
  "requiredTokens": [
    "color.background.canvas",
    "color.text.primary",
    "touch.target.min",
    "color.focus.ring"
  ],
  "allowedDependencies": [
    "@inteiro/tokens",
    "@inteiro/design-system"
  ],
  "accessibility": {
    "semantics": [
      "header",
      "a",
      "nav"
    ],
    "keyboardSpec": "docs/P0_PATTERNS.md"
  },
  "responsive": {
    "mobileStrategy": "reflow"
  },
  "examples": [
    "examples/topbar.html",
    "examples/topbar-default.html"
  ],
  "tests": [
    "tests/browser/composition.spec.ts"
  ],
  "aliases": [
    "barra",
    "superior"
  ],
  "markup": "<header class=\"in-topbar\"><a href=\"/\">INTEIRO</a><nav aria-label=\"Atalhos\"><a href=\"#content\">Conteúdo</a></nav></header>"
}
