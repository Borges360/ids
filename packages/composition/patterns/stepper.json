{
  "schemaVersion": "1.0",
  "id": "stepper",
  "version": "1.0.0",
  "kind": "pattern",
  "description": "Etapas fluxo progressão",
  "slots": [
    "content"
  ],
  "variants": [
    "default"
  ],
  "states": [
    "default"
  ],
  "requiredTokens": [
    "color.background.canvas",
    "color.text.primary"
  ],
  "allowedDependencies": [
    "@inteiro/tokens",
    "@inteiro/design-system"
  ],
  "accessibility": {
    "semantics": [
      "nav",
      "ol",
      "li"
    ],
    "keyboardSpec": "docs/P0_PATTERNS.md"
  },
  "responsive": {
    "mobileStrategy": "reflow"
  },
  "examples": [
    "examples/stepper.html",
    "examples/stepper-default.html"
  ],
  "tests": [
    "tests/browser/composition.spec.ts"
  ],
  "aliases": [
    "etapas",
    "fluxo",
    "progressão"
  ],
  "markup": "<nav aria-label=\"Etapas\"><ol><li aria-current=\"step\">Dados</li><li>Revisão</li><li>Confirmação</li></ol></nav>"
}
