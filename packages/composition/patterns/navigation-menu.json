{
  "schemaVersion": "1.0",
  "id": "navigation-menu",
  "version": "1.0.0",
  "kind": "pattern",
  "description": "Menu navegação principal",
  "slots": [
    "content"
  ],
  "variants": [
    "default"
  ],
  "states": [
    "default"
  ],
  "requiredTokens": [
    "color.background.canvas",
    "color.text.primary",
    "touch.target.min",
    "color.focus.ring"
  ],
  "allowedDependencies": [
    "@inteiro/tokens",
    "@inteiro/design-system"
  ],
  "accessibility": {
    "semantics": [
      "nav",
      "a"
    ],
    "keyboardSpec": "docs/P0_PATTERNS.md"
  },
  "responsive": {
    "mobileStrategy": "reflow"
  },
  "examples": [
    "examples/navigation-menu.html",
    "examples/navigation-menu-default.html"
  ],
  "tests": [
    "tests/browser/composition.spec.ts"
  ],
  "aliases": [
    "menu",
    "navegação",
    "principal"
  ],
  "markup": "<nav aria-label=\"Principal\"><a href=\"#content\" aria-current=\"page\">Início</a> <a href=\"#settings\">Configuração</a></nav>"
}
