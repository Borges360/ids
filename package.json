{
  "name": "inteiro",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "INTEIRO — Identity Design System pessoal, completo e production-ready",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "npm run build -w @inteiro/tokens && npm run build -w @inteiro/agent-core && npm run build -w @inteiro/cli && npm run build -w @inteiro/mcp && npm run build -w @inteiro/design-system && npm run build -w @inteiro/react && npm run build -w @inteiro/skills",
    "validate": "npm run validate -w @inteiro/tokens",
    "test": "vitest run",
    "test:contrast": "vitest run tests/contrast",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:check": "npm pack --dry-run -w @inteiro/tokens && npm pack --dry-run -w @inteiro/cli && npm pack --dry-run -w @inteiro/design-system",
    "generate": "npm run build -w @inteiro/tokens && npm run generate -w @inteiro/skills",
    "demo": "node scripts/serve-demo.mjs",
    "ci": "npm run lint && npm run validate && npm run test && npm run test:contrast && npm run build && npm run pack:check"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "dependencies": {
    "assertion-error": "^2.0.1",
    "cac": "^6.7.14",
    "chai": "^5.3.3",
    "check-error": "^2.1.3",
    "debug": "^4.4.3",
    "deep-eql": "^5.0.2",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.28.2",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.4.0",
    "fdir": "^6.5.0",
    "js-tokens": "^9.0.1",
    "loupe": "^3.2.1",
    "magic-string": "^0.30.21",
    "ms": "^2.1.3",
    "nanoid": "^3.3.20",
    "pathe": "^2.0.3",
    "pathval": "^2.0.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "rollup": "^4.64.5",
    "siginfo": "^2.0.0",
    "source-map-js": "^1.2.2",
    "stackback": "^0.0.2",
    "std-env": "^3.10.0",
    "strip-literal": "^3.1.0",
    "tinybench": "^2.9.0",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.17",
    "tinypool": "^1.1.1",
    "tinyrainbow": "^2.0.0",
    "tinyspy": "^4.0.6",
    "undici-types": "^7.24.6",
    "vite": "^7.3.7",
    "vite-node": "^3.2.4",
    "why-is-node-running": "^2.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Borges360/ids.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/Borges360/ids/issues"
  },
  "homepage": "https://github.com/Borges360/ids#readme"
}
