{
  "name": "inteiro",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "INTEIRO — Identity Design System pessoal, completo e production-ready",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "npm run build -w @inteiro/tokens && npm run build:composition && npm run build -w @inteiro/agent-core && npm run build -w @inteiro/cli && npm run build -w @inteiro/mcp && npm run build -w @inteiro/design-system && npm run build -w @inteiro/react && npm run build -w @inteiro/skills && npm run build:terminal",
    "validate": "npm run validate -w @inteiro/tokens",
    "pretest": "npm run build -w @inteiro/tokens && npm run build:composition",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.mjs",
    "test:contrast": "vitest run tests/contrast",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json && eslint packages/react/src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pack:check": "npm pack --dry-run -w @inteiro/tokens && npm pack --dry-run -w @inteiro/cli && npm pack --dry-run -w @inteiro/design-system && npm pack --dry-run -w @inteiro/react && npm pack --dry-run -w @inteiro/mcp && npm pack --dry-run -w @inteiro/agent-core && npm pack --dry-run -w @inteiro/terminal",
    "generate": "npm run build -w @inteiro/tokens && npm run generate -w @inteiro/skills",
    "demo": "node scripts/serve-demo.mjs",
    "ci": "npm run lint && npm run validate && npm test && npm run build && npm run build:platforms && npm run build:docs && npm run build:fixtures && npm run build:storybook && npm run build:site && npm run check:tokens && npm run check:bundle && npm run pack:check && npm run check:p0 && npm run check:compat",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "build:platforms": "node --experimental-strip-types packages/tokens/src/build-android.ts",
    "test:browser": "playwright test",
    "test:visual": "chromatic",
    "build:site": "node scripts/build-site.mjs",
    "build:docs": "node scripts/generate-docs.ts && node scripts/generate-library-docs.mjs",
    "check:tokens": "node scripts/check-token-changes.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "generate:p0": "node scripts/generate-contract-schemas.mjs && node scripts/generate-composition.mjs && node scripts/generate-pattern-stories.mjs",
    "test:stories": "vitest run --config .storybook/vitest.config.ts",
    "test:p0": "vitest run tests/p0",
    "benchmark:p0": "node packages/cli/src/cli.ts benchmark run --suite p0-smoke --json",
    "gate:p0": "node packages/cli/src/cli.ts gate run --profile release --json",
    "check:p0": "node scripts/check-p0.mjs",
    "build:fixtures": "node scripts/build-framework-fixtures.mjs --next",
    "test:browser-gate": "node scripts/test-browser-gate.mjs",
    "test:benchmark-grading": "node scripts/test-task-grading.mjs",
    "test:worker-isolation": "node scripts/test-worker-isolation.mjs",
    "test:public-contracts": "node scripts/test-public-control.mjs --full",
    "test:public-workers": "node scripts/qualify-public-workers.mjs",
    "test:worker-bootstrap": "node scripts/test-worker-bootstrap.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "pack:p0": "node scripts/pack-p0.mjs",
    "smoke:offline": "node scripts/smoke-offline.mjs",
    "measure:p0": "node scripts/measure-p0.mjs --canary",
    "build:composition": "node scripts/build-composition.mjs",
    "verify:p0": "node scripts/verify-p0.mjs",
    "check:compat": "node scripts/check-legacy-compat.mjs",
    "generate:terminal": "node scripts/generate-terminal.mjs",
    "test:terminal": "vitest run tests/terminal",
    "build:terminal": "node scripts/generate-terminal.mjs",
    "smoke:terminal:posix": "python3 scripts/smoke-terminal-posix.py"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^1.5.2",
    "@fontsource-variable/recursive": "5.3.0",
    "@inquirer/prompts": "^7.10.1",
    "@inteiro/visual": "^1.3.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.5",
    "axe-core": "^4.14.0",
    "chromatic": "^18.13.0",
    "eslint": "^10.13.0",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "next": "^16.4.6",
    "prettier": "^3.9.10",
    "storybook": "^10.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "license": "MIT",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "dependencies": {
    "assertion-error": "^2.0.1",
    "cac": "^6.7.14",
    "chai": "^5.3.3",
    "check-error": "^2.1.3",
    "debug": "^4.4.3",
    "deep-eql": "^5.0.2",
    "es-module-lexer": "^1.7.0",
    "esbuild": "^0.28.2",
    "estree-walker": "^3.0.3",
    "expect-type": "^1.4.0",
    "fdir": "^6.5.0",
    "js-tokens": "^9.0.1",
    "loupe": "^3.2.1",
    "magic-string": "^0.30.21",
    "ms": "^2.1.3",
    "nanoid": "^3.3.20",
    "pathe": "^2.0.3",
    "pathval": "^2.0.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.1",
    "rollup": "^4.64.5",
    "siginfo": "^2.0.0",
    "source-map-js": "^1.2.2",
    "stackback": "^0.0.2",
    "std-env": "^3.10.0",
    "strip-literal": "^3.1.0",
    "tinybench": "^2.9.0",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.17",
    "tinypool": "^2.2.0",
    "tinyrainbow": "^2.0.0",
    "tinyspy": "^4.0.6",
    "undici-types": "^7.24.6",
    "vite": "^7.3.7",
    "vite-node": "^3.2.4",
    "why-is-node-running": "^2.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Borges360/ids.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/Borges360/ids/issues"
  },
  "homepage": "https://github.com/Borges360/ids#readme",
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.8",
    "glob@>=9 <14.0.2": "^14.0.5"
  }
}
